<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP Dashboard Suite" parallel="false" preserve-order="true"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
        <listener class-name="com.vuatho.tests.conditions.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
    </listeners>
    <test name="Dashboard catalog, quality and UI">
        <classes>
            <class name="com.vuatho.tests.dashboard.AutomationFrameworkQualityTest"/>
            <class name="com.vuatho.tests.dashboard.WorkbookCatalogTest"/>
            <class name="com.vuatho.tests.dashboard.LoginSourceAccessTest"/>
            <class name="com.vuatho.tests.dashboard.CoreUiTest"/>
            <class name="com.vuatho.tests.dashboard.SummaryCardsTest"/>
            <class name="com.vuatho.tests.dashboard.WorkbookUiTest"/>
            <class name="com.vuatho.tests.dashboard.LogoutTest"/>
        </classes>
    </test>
</suite>
