<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP Uniform Management" verbose="1" preserve-order="true" parallel="false"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.listeners.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
        <listener class-name="com.vuatho.reporting.UniformCatalogResultReporter"/>
    </listeners>
    <test name="Uniform testcase catalog">
        <classes>
            <class name="com.vuatho.validation.catalog.UniformCatalogJsonCatalogTest"/>
        </classes>
    </test>
    <test name="Uniform catalog, orders and inventory">
        <classes>
            <class name="com.vuatho.tests.uniform.catalog.UniformCatalogOverviewTest"/>
            <class name="com.vuatho.tests.uniform.catalog.UniformCatalogSearchFilterTest"/>
            <class name="com.vuatho.tests.uniform.catalog.UniformCatalogDrawerTest"/>
            <class name="com.vuatho.tests.uniform.catalog.UniformCatalogPaginationTest"/>
            <class name="com.vuatho.tests.uniform.catalog.UniformCatalogSafeInteractionTest"/>
            <class name="com.vuatho.tests.uniform.catalog.UniformCatalogCrudTest"/>
            <class name="com.vuatho.tests.uniform.order.UniformOrderOverviewTest"/>
            <class name="com.vuatho.tests.uniform.order.UniformOrderSearchFilterTest"/>
            <class name="com.vuatho.tests.uniform.order.UniformOrderDrawerTest"/>
            <class name="com.vuatho.tests.uniform.inventory.UniformInventoryOverviewTest"/>
            <class name="com.vuatho.tests.uniform.inventory.UniformInventoryReceiptTest"/>
            <class name="com.vuatho.tests.uniform.inventory.UniformInventoryDialogTest"/>
        </classes>
    </test>
</suite>
