<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP Customer Worker Order" verbose="1" preserve-order="true" parallel="false"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.listeners.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
    </listeners>
    <test name="Read-only checks followed by the existing workflow">
        <groups>
            <run>
                <include name="data-interaction"/>
            </run>
        </groups>
        <classes>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderOverviewTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderSearchFilterTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderViewModeTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderExportTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderStatusStatisticsTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderWarrantyStatisticsTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderPaginationTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderDetailTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderAdvancePopupTest"/>
            <class name="com.vuatho.tests.customerworkerorder.CustomerWorkerOrderWorkflowTest"/>
        </classes>
    </test>
</suite>
