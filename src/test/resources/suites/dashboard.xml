<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP Dashboard" verbose="1" preserve-order="true" parallel="false"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.listeners.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
    </listeners>
    <test name="Dashboard catalog, login and UI">
        <classes>
            <class name="com.vuatho.validation.catalog.DashboardWorkbookCatalogTest"/>
            <class name="com.vuatho.quality.DashboardAutomationFrameworkQualityTest"/>
            <class name="com.vuatho.tests.dashboard.LoginDashboardSourceAccessTest"/>
            <class name="com.vuatho.tests.dashboard.DashboardCoreUiTest"/>
            <class name="com.vuatho.tests.dashboard.DashboardSummaryCardsTest"/>
            <class name="com.vuatho.tests.dashboard.DashboardWorkbookUiTest"/>
            <class name="com.vuatho.tests.dashboard.DashboardLogoutTest"/>
        </classes>
    </test>
</suite>
