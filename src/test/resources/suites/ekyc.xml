<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP eKYC Safe Regression" verbose="1" preserve-order="true" parallel="false"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.listeners.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
    </listeners>
    <test name="eKYC catalogs and read-only API contracts">
        <classes>
            <class name="com.vuatho.validation.catalog.EkycWorkbookCatalogTest"/>
            <class name="com.vuatho.validation.testdata.EkycInformationTestDataTest"/>
            <class name="com.vuatho.tests.ekyc.api.EkycDashboardApiContractTest"/>
            <class name="com.vuatho.tests.ekyc.api.EkycListApiContractTest"/>
            <class name="com.vuatho.tests.ekyc.api.EkycDetailApiContractTest"/>
            <class name="com.vuatho.tests.ekyc.api.EkycSecurityApiContractTest"/>
        </classes>
    </test>
</suite>
