<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP Safe Regression" verbose="1" preserve-order="true" parallel="false"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.listeners.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
        <listener class-name="com.vuatho.reporting.UniformCatalogResultReporter"/>
    </listeners>
    <test name="Dashboard, eKYC, Uniform and Customer Worker Order safe checks">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.vuatho.tests.dashboard"/>
            <package name="com.vuatho.tests.ekyc.*"/>
            <package name="com.vuatho.tests.uniform.*"/>
            <package name="com.vuatho.tests.customerworkerorder"/>
        </packages>
    </test>
</suite>
