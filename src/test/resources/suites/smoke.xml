<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ERP Smoke" verbose="1" preserve-order="true" parallel="false"
       configfailurepolicy="continue">
    <listeners>
        <listener class-name="com.vuatho.listeners.LogoutTestsEnabled"/>
        <listener class-name="com.vuatho.core.DriverLifecycleListener"/>
        <listener class-name="com.vuatho.reporting.ConsoleTestListener"/>
    </listeners>
    <test name="Reachability, login and dashboard">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.vuatho.tests.smoke.ErpSandboxAccessSmokeTest"/>
            <class name="com.vuatho.tests.dashboard.LoginDashboardSourceAccessTest"/>
        </classes>
    </test>
</suite>
